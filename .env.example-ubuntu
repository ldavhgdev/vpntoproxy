# Proxy Manager - Node.js Configuration for Ubuntu VPS
# Copy to .env and edit as needed

# ============================================================================
# APPLICATION
# ============================================================================

# Environment mode
NODE_ENV=production

# Web UI binding address
# 127.0.0.1 = only this machine
# 0.0.0.0 = all interfaces (LAN accessible, requires password)
APP_HOST=127.0.0.1

# Web UI port
APP_PORT=8686

# Web UI password (empty = no password)
# Required if APP_HOST is 0.0.0.0
APP_PASSWORD=

# ============================================================================
# PORTS
# ============================================================================

# Base port for SOCKS5 proxies (tunnels will use: base, base+1, base+2, ...)
SOCKS_BASE_PORT=20001

# Base port for HTTP proxies
HTTP_BASE_PORT=30001

# ============================================================================
# HEALTH CHECKS
# ============================================================================

# Interval between health checks (seconds)
HEALTH_CHECK_INTERVAL=30

# Number of consecutive failures before auto-restart
FAIL_THRESHOLD=3

# URL to check proxy connectivity
# Using Cloudflare trace for IP detection
CHECK_URL=https://www.cloudflare.com/cdn-cgi/trace

# ============================================================================
# WIREGUARD
# ============================================================================

# PersistentKeepalive value for WireGuard (seconds)
# Helps maintain connection on unstable networks
KEEPALIVE=25

# ============================================================================
# DIRECTORIES
# ============================================================================

# Base directory (auto-detected if not set)
# BASE_DIR=/opt/proxy-manager

# Where to store WireGuard config files (.conf)
CONFIG_DIR=/opt/proxy-manager/configs

# Where to store runtime configs and temp files
RUNTIME_DIR=/opt/proxy-manager/runtime

# Where to store log files
LOG_DIR=/opt/proxy-manager/logs

# Where to store persistent data (state.json)
DATA_DIR=/opt/proxy-manager/data

# Where wireproxy binary is located
BIN_DIR=/opt/proxy-manager/bin

# ============================================================================
# NOTES
# ============================================================================

# After modifying this file, restart the service:
#   sudo systemctl restart proxy-manager
#
# Or if running manually:
#   node app.js
#
# Port ranges:
# - SOCKS proxies: SOCKS_BASE_PORT to SOCKS_BASE_PORT + (number of tunnels)
# - HTTP proxies: HTTP_BASE_PORT to HTTP_BASE_PORT + (number of tunnels)
#
# Example with default settings:
# - 1st tunnel: SOCKS5 20001, HTTP 30001
# - 2nd tunnel: SOCKS5 20002, HTTP 30002
# - 3rd tunnel: SOCKS5 20003, HTTP 30003
#
# Security tips:
# - Always set APP_PASSWORD if APP_HOST is 0.0.0.0
# - Keep CONFIG_DIR secure (contains WireGuard keys)
# - Use UFW to restrict port access if needed:
#   sudo ufw allow 8686/tcp
#   sudo ufw allow 20001:20100/tcp
#   sudo ufw allow 30001:30100/tcp
