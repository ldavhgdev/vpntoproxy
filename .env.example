# VPN to Proxy Manager Configuration

# Surfshark Credentials
SURFSHARK_USER=your_surfshark_username
SURFSHARK_PASS=your_surfshark_password

# VPN Connection Type: wireguard or openvpn
VPN_PROTOCOL=wireguard

# Proxy Settings
SOCKS5_PORT=1080
HTTP_PROXY_PORT=8888
MANAGEMENT_PORT=3000

# VPN Server Location (Surfshark server identifier)
# Examples: us-nyc, gb-lon, fr-par, nl-ams, de-ber
VPN_LOCATION=us-nyc

# Auto Rotating IP Settings
ROTATE_INTERVAL_MINUTES=30
AUTO_ROTATE=true
ROTATE_ON_CONNECTION_FAIL=true

# Connection Recovery
RECOVERY_CHECK_INTERVAL=60
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_RETRY_DELAY=10

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/vpn-to-proxy/app.log

# Web UI
WEB_UI_ENABLED=true
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=changeMe123!

# API Settings
API_KEY_ENABLED=true
API_KEY=your-random-api-key-here

# System
NODE_ENV=production
